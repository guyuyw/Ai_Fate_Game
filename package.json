{
  "name": "ai-fate-codex-handoff",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Codex P0/P1 handoff scaffold; engine implementation not included",
  "engines": {"node": ">=22"},
  "workspaces": ["packages/*"],
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test:p1": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "@types/node": "22.15.21",
    "ajv": "8.17.1"
  }
}
