{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story scenes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenes"
  ],
  "properties": {
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "access",
          "availableObjects"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "access": {
            "enum": [
              "initial",
              "locked"
            ]
          },
          "availableObjects": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/id"
            },
            "minItems": 0
          }
        }
      },
      "minItems": 1
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    }
  }
}
