{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story world",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "worldRules",
    "facts",
    "flags"
  ],
  "properties": {
    "worldRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "immutable",
          "description"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "immutable": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "minItems": 0
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "initialKnownTo",
          "hiddenFromPlayerAtStart"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "initialKnownTo": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/id"
            },
            "minItems": 0
          },
          "hiddenFromPlayerAtStart": {
            "type": "boolean"
          }
        }
      },
      "minItems": 0
    },
    "flags": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "number"
        ]
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    }
  }
}
